        "empresas_nome": {
          "name": "empresas_nome",
          "value": "length(trim(\"empresas\".\"nome\")) between 2 and 120"
        },
        "empresas_slug": {
          "name": "empresas_slug",
          "value": "length(\"empresas\".\"slug\") between 3 and 60\n        and \"empresas\".\"slug\" not glob '*[^a-z0-9-]*'\n        and \"empresas\".\"slug\" not like '-%' and \"empresas\".\"slug\" not like '%-' and instr(\"empresas\".\"slug\", '--') = 0\n        and \"empresas\".\"slug\" not in ('admin', 'api', 'login', 'sair', 'static', 'public', 'assets', 'favicon-ico', 'icones')"
        },
        "empresas_limite_masters": {
          "name": "empresas_limite_masters",
          "value": "\"empresas\".\"limite_masters\" >= 1"
        },
        "empresas_limite_revendedores": {
          "name": "empresas_limite_revendedores",
          "value": "\"empresas\".\"limite_revendedores\" >= 0"
        }
      }
