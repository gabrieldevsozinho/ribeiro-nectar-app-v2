{
  "name": "ribeiro-nectar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --env-interface Env",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "wrangler d1 migrations apply DB --local",
    "db:migrar-producao": "wrangler d1 migrations apply DB --remote",
    "db:reset": "node scripts/apagar-banco-local.mjs && npm run db:migrar",
    "db:seed": "tsx scripts/seed-dev.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.5",
    "@vis.gl/react-google-maps": "^1.10.1",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.7",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  }
}
