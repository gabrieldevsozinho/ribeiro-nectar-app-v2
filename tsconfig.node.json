{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  // Os scripts de seed e de admin usam o código do Worker: entram os tipos do runtime também.
  "include": ["vite.config.ts", "vitest.config.ts", "drizzle.config.ts", "scripts", "src/worker/worker-configuration.d.ts"]
}
