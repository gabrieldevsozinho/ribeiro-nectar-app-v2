{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ribeiro-nectar",
  // API (Hono) no Worker; o app React é servido como arquivos estáticos.
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // O D1 não roda na América do Sul: o banco fica na região ENAM, servido de Miami (MIA). O Worker roda na
  // região de nuvem mais próxima dele (Google, Carolina do Sul): as várias consultas de cada tela ficam
  // rápidas e sobra uma só ida e volta Brasil ↔ EUA por requisição. Os arquivos das telas continuam saindo
  // do servidor mais próximo do usuário. (O modo "smart" faria isso sozinho, mas só depois de observar
  // tráfego de vários lugares.)
  "placement": { "region": "gcp:us-east1" },
  "assets": {
    // Qualquer endereço que não seja arquivo devolve o index.html (o React Router decide a tela).
    "not_found_handling": "single-page-application",
    // A API e o testador do Google Maps passam sempre pelo Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banco-ribeiro-nectar",
      "database_id": "f8c30fea-81b6-4937-8fec-03941d3d19b4",
      "migrations_dir": "drizzle/migracoes"
    }
  ],
  // R2 entra na Fase 2 (fotos e comprovantes de venda). Para ativar:
  // 1. `npx wrangler r2 bucket create ribeiro-nectar-arquivos`
  // 2. descomente o bloco abaixo e rode `npm run cf-typegen`.
  // "r2_buckets": [{ "binding": "ARQUIVOS", "bucket_name": "ribeiro-nectar-arquivos" }],
  "vars": {
    "AMBIENTE": "producao",
    // Endereço público do sistema. Troque por https://www.ribeironectar.com.br quando o domínio for ligado.
    "BETTER_AUTH_URL": "https://ribeiro-nectar.gabriel-sistemas-00.workers.dev",
    // "osm" enquanto o sistema está em teste; "google" quando as empresas cadastrarem as próprias chaves.
    "MAPA_PROVEDOR": "osm",
    "EMAIL_REMETENTE": "Ribeiro Néctar <nao-responda@ribeironectar.com.br>",
    "NOMINATIM_CONTATO": "contato@gabrielstudio.com.br",
    "GOOGLE_MAPS_CHAVE_DEV": ""
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
}
